        <mxCell id="ctr_omod" value="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;Attachments OMOD REST API&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: Java, Spring MVC, OpenMRS REST]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;Contains AttachmentResource, AttachmentBytesResource and upload/download REST endpoints.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1">
